<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputType>WinExe</OutputType>
    <AssemblyName>IconController</AssemblyName>
    <RootNamespace>IconController</RootNamespace>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputPath>build\</OutputPath>
    <IntermediateOutputPath>build\obj\</IntermediateOutputPath>
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/>
    <Reference Include="System.Drawing"/><Reference Include="System.Windows.Forms"/>
    <Reference Include="System.Runtime.Serialization"/>
    <Compile Include="src\App.cs"/><Compile Include="src\Core.cs"/>
    <EmbeddedResource Include="src\ApplyTemplate.ps1"><LogicalName>ApplyTemplate</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\catalog.json"><LogicalName>BuiltinCatalog</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\julia\julia.ico"><LogicalName>Builtin.Julia</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\typst\typst.ico"><LogicalName>Builtin.Typst</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
